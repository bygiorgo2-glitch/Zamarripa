{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.tamano_titulo }}px; }
{% endstyle %}

<section id="como-funciona" class="mt-section mt-como">
  <div class="mt-container">
    <div class="mt-como-encabezado mt-reveal">
      <span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="mt-h2">{{ section.settings.headline }}</h2>
      {%- if section.settings.subheadline != blank -%}
        <p class="mt-como-sub">{{ section.settings.subheadline }}</p>
      {%- endif -%}
    </div>

    <div class="mt-como-pasos">
      {%- for block in section.blocks -%}
        <div class="mt-paso mt-reveal mt-reveal-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="mt-paso-numero">{{ forloop.index }}</div>
          <div class="mt-paso-media">
            {%- if block.settings.imagen != blank -%}
              <img src="{{ block.settings.imagen | image_url: width: 900 }}"
                   srcset="{{ block.settings.imagen | image_url: width: 500 }} 500w, {{ block.settings.imagen | image_url: width: 900 }} 900w"
                   sizes="(max-width: 749px) 90vw, 380px"
                   alt="{{ block.settings.imagen.alt | default: block.settings.titulo | escape }}"
                   loading="lazy">
            {%- else -%}
              <img src="{{ block.settings.imagen_respaldo | asset_url }}" alt="{{ block.settings.titulo | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          <h3 class="mt-paso-titulo">{{ block.settings.titulo }}</h3>
          <p class="mt-paso-texto">{{ block.settings.texto }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Cómo funciona",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Así de simple" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Tres pasos y listo" },
    { "type": "textarea", "id": "subheadline", "label": "Texto de apoyo", "default": "Sin apps que descargar, sin cuentas que crear. Funciona con cualquier celular." },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto del paso" },
        { "type": "text", "id": "imagen_respaldo", "label": "Nombre archivo de respaldo (uso interno)", "default": "mt-paso-1.jpg" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Acerca el celular" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "El cliente apoya su teléfono sobre la placa (NFC) o escanea el código QR si lo prefiere." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT – Cómo funciona",
      "blocks": [
        { "type": "paso", "settings": { "titulo": "Acerca el celular", "texto": "El cliente apoya su teléfono sobre la placa (NFC) o escanea el código QR si lo prefiere.", "imagen_respaldo": "mt-paso-1.jpg" } },
        { "type": "paso", "settings": { "titulo": "Se abre la reseña al instante", "texto": "Sin buscar tu negocio ni escribir nada: la ventana de reseña de Google aparece directa en su pantalla.", "imagen_respaldo": "mt-paso-2.jpg" } },
        { "type": "paso", "settings": { "titulo": "Te deja sus 5 estrellas", "texto": "Escribe unas palabras y publica. Todo en menos de 10 segundos, sin fricción.", "imagen_respaldo": "mt-paso-3.jpg" } }
      ]
    }
  ]
}
{% endschema %}
