{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
{% endstyle %}

<section class="mt-section mt-resenas">
  <div class="mt-container">
    <div class="mt-como-encabezado mt-reveal">
      <span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="mt-h2">{{ section.settings.headline }}</h2>
    </div>
  </div>

  <div class="mt-container mt-resenas-controles">
    <button type="button" class="mt-carrusel-flecha" data-mt-prev aria-label="Anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="mt-carrusel-flecha" data-mt-next aria-label="Siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="mt-container mt-carrusel-wrap" data-mt-carrusel>
    <div class="mt-resenas-pista" data-mt-pista>
      {%- for block in section.blocks -%}
        <article class="mt-resena-tarjeta mt-tarjeta" {{ block.shopify_attributes }}>
          <div class="mt-resena-estrellas" aria-hidden="true">
            {%- for e in (1..5) -%}
              {%- if e <= block.settings.estrellas -%}
                <svg width="16" height="16" viewBox="0 0 20 20" fill="#ffb800"><path d="M10 1l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 15l-5.6 3.1 1.4-6.3L1 7.5l6.4-.6L10 1z"/></svg>
              {%- else -%}
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="#d9dfe8"><path d="M10 1l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 15l-5.6 3.1 1.4-6.3L1 7.5l6.4-.6L10 1z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="mt-resena-texto">&ldquo;{{ block.settings.texto }}&rdquo;</p>
          <div class="mt-resena-autor">
            {%- if block.settings.imagen != blank -%}
              <img class="mt-resena-avatar" src="{{ block.settings.imagen | image_url: width: 96 }}" alt="{{ block.settings.nombre | escape }}" loading="lazy" width="44" height="44">
            {%- else -%}
              <span class="mt-resena-avatar mt-resena-avatar-inicial">{{ block.settings.nombre | slice: 0, 1 }}</span>
            {%- endif -%}
            <div>
              <strong class="mt-resena-nombre">{{ block.settings.nombre }}</strong>
              <span class="mt-resena-negocio">{{ block.settings.negocio }}</span>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Reseñas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Negocios reales" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Lo que dicen quienes ya lo usan" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#f4f7fc" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto (opcional)" },
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Ana Torres" },
        { "type": "text", "id": "negocio", "label": "Negocio", "default": "Café Origen" },
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "texto", "label": "Testimonio", "default": "Antes pedíamos reseñas y nadie las dejaba. Con la placa en la caja, ahora sumamos varias cada día sin pedirlo casi." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT – Reseñas",
      "blocks": [
        { "type": "resena", "settings": { "nombre": "Ana Torres", "negocio": "Café Origen", "estrellas": 5, "texto": "Antes pedíamos reseñas y nadie las dejaba. Con la placa en la caja, ahora sumamos varias cada día sin pedirlo casi." } },
        { "type": "resena", "settings": { "nombre": "Julián Reyes", "negocio": "Barbería Reyes", "estrellas": 5, "texto": "Se paga sola: en un mes subimos de 4.3 a 4.8 estrellas en Google y se nota en las reservas." } },
        { "type": "resena", "settings": { "nombre": "Marcela Ibáñez", "negocio": "Clínica Dental Ibáñez", "estrellas": 5, "texto": "Los pacientes la usan sin que nadie les explique nada. Es literal apoyar el celular y listo." } },
        { "type": "resena", "settings": { "nombre": "Diego Salas", "negocio": "Tienda Salas", "estrellas": 5, "texto": "La calidad del material es muy buena y llegó rápido. La puse junto a la caja registradora y ya funciona sola." } }
      ]
    }
  ]
}
{% endschema %}
